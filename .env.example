# Google Calendar / Google Meet Integration
# 1. Obtenha as credenciais no Google Cloud Console (Service Account ou OAuth2)
# 2. Habilite a "Google Calendar API" no seu projeto GCP
# 3. Compartilhe sua agenda do Google com o client_email da Service Account com permissão de edição

GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=""
GOOGLE_CALENDAR_ID="primary"

# Honeypot / Rate Limit Salt (opcional)
RATE_LIMIT_SALT="portfolio-anti-spam-secret"
